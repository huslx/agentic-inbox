{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "agentic-inbox-export",
	"main": "./workers/export.ts",
	"compatibility_date": "2025-11-28",
	"durable_objects": {
		"bindings": [
			{ "name": "MAILBOX", "class_name": "MailboxDO", "script_name": "agentic-inbox" }
		]
	},
	"r2_buckets": [
		{ "binding": "BUCKET", "bucket_name": "agentic-inbox" }
	]
}

